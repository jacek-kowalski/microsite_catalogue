{
  "id": "polls-surveys",
  "name": "Polls & surveys",
  "category": "general",
  "summary": "Ask viewers a question on the TV — 2–4 answers, a reward QR code for the right one, and 0–3 videos.",
  "description": "A quiz or poll the viewer answers with the remote. A correct answer reveals a QR code with a reward (e.g. a discount); a wrong one offers \"Try again\". Add a brand logo, a footer line and up to three videos; the layout adapts to 0, 1 or 2–3 videos like the QR and Click-to-Email templates.",
  "features": [
    "2–4 answers",
    "Reward QR code",
    "0–3 videos",
    "Try again flow"
  ],
  "remoteHints": [
    "▲ ▼ choose an answer",
    "◀ ▶ move between poll and video",
    "OK answer / try again / play video",
    "BACK back to question / exit"
  ],
  "interactive": true,
  "thumbnail": "mocks/variant1-01.jpg",
  "host": null,
  "examples": [
    {
      "id": "default",
      "name": "Poll",
      "entry": "examples/default/index.html",
      "query": "?target_url=https://www.samsung.com"
    }
  ],
